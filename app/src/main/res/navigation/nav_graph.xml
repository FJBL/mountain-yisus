<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/HomeFragment">

    <fragment
        android:id="@+id/HomeFragment"
        android:name="com.mx.mountain.HomeFragment"
        android:label="Mountain"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.mx.mountain.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.mx.mountain.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
    <fragment
        android:id="@+id/AbcdeFragment"
        android:name="com.mx.mountain.AbcdeFragment"
        android:label="Evaluación ABCDE"
        tools:layout="@layout/fragment_abcde" />
    <fragment
        android:id="@+id/HeatFragment"
        android:name="com.mx.mountain.HeatFragment"
        android:label="Golpe de calor"
        tools:layout="@layout/fragment_heat" />
    <fragment
        android:id="@+id/GpxFragment"
        android:name="com.mx.mountain.GpxFragment"
        android:label="Rutas GPX 3D"
        tools:layout="@layout/fragment_gpx" />
</navigation>